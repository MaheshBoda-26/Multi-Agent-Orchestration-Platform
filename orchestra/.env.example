# Environment variables for Orchestra Multi-Agent Orchestration Platform

# Database
DATABASE_URL=postgresql://orchestra:orchestra@localhost:5432/orchestra

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# LLM provider selection: fake | openrouter
LLM_PROVIDER=fake
OPENROUTER_API_KEY=

# Embeddings for long-term memory (OpenAI-compatible endpoint)
OPENAI_API_KEY=

# Tools
TAVILY_API_KEY=
WORKSPACES_ROOT=./workspaces

# Security
SECRET_KEY=your_secret_key_here_for_jwt_tokens
